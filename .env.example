# Copia este fichero a ".env" y rellena tus valores. Nunca subas el ".env" real (ya está en
# .gitignore) — contiene contraseñas.

# --- Obligatorio ---
# Credenciales del primer usuario (administrador), se crean solas al arrancar por primera vez.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esto-por-algo-largo

# Ruta absoluta del home en el HOST donde corre Docker (no dentro del contenedor). El panel
# necesita verla para poder desplegar/gestionar otros proyectos tuyos que vivan al lado, y para
# reflejar el disco real del host en las métricas de servidor. Debe coincidir con la ruta real.
HOST_HOME=/home/tu-usuario

# --- Recomendado ---
# URL pública desde la que se sirve el panel (con esquema). Se usa para construir los enlaces
# absolutos de las propuestas publicadas y de los avisos por email. Déjalo vacío si solo vas a
# usar el panel en tu LAN — simplemente no se generarán esos enlaces.
PANEL_BASE_URL=https://panel.tudominio.com

# Puerto en el que se expone el panel directamente (aparte de cualquier reverse proxy).
PANEL_LAN_PORT=8082

# Solo si usas el bloque de labels de Traefik en docker-compose.yml (reverse proxy compartiendo
# una red "edge"). Si no usas Traefik, borra ese bloque de labels y esta variable no hace falta.
PANEL_HOSTNAME=panel.tudominio.com

# --- Opcional: envío de email (facturas/propuestas por correo y notificaciones críticas) ---
# Sin esto configurado, todo lo demás funciona igual; solo fallará el botón "enviar por email"
# y las notificaciones no llegarán por correo (seguirán viéndose en la web).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=una-contraseña-de-aplicación
SMTP_FROM=tu-cuenta@gmail.com

# --- Opcional: solo si tus binarios de restic/rclone o tu configuración no están en las rutas
# por defecto (todas relativas a HOST_HOME). Normalmente no hace falta tocar esto. ---
# RESTIC_BIN=/home/tu-usuario/.local/bin/restic
# RCLONE_BIN=/home/tu-usuario/.local/bin/rclone
# RCLONE_CONFIG_PATH=/home/tu-usuario/.config/rclone/rclone.conf
# RESTIC_PASSPHRASE_FILE=/home/tu-usuario/infra/backups/restic-passphrase.txt
# PANEL_HOST_DIR=/home/tu-usuario/panel
